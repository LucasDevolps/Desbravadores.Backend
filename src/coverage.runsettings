<?xml version="1.0" encoding="utf-8"?>
<!--
  Coleta de cobertura (Coverlet, coverlet.collector) usada pelo CI e localmente. Política e exclusões
  documentadas em docs/test-coverage.md; qualquer exclusão nova precisa de justificativa lá.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- OpenCover para a união das suítes (ramos por offset no IL, ver scripts/coverage.sh); Cobertura para leitura direta. -->
          <Format>cobertura,opencover</Format>
          <!-- Só código de produção; o assembly de testes nunca entra na métrica. -->
          <Include>[Almirante.Api]*,[Almirante.ServiceDefaults]*</Include>
          <!--
            Só código gerado por ferramenta, fora do controle de quem escreve a API:
            - metadados de modelo do `dotnet ef` (// <auto-generated />); o Up/Down das migrations continua medido;
            - saída de source generators em obj/ (Regex, comentários XML do OpenAPI), que nem existe no repositório.
          -->
          <ExcludeByFile>**/Data/Migrations/*.Designer.cs,**/Data/Migrations/*ModelSnapshot.cs,**/obj/**/*.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
