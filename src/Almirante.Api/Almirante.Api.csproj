<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Segredos locais de desenvolvimento (Jwt:Keys, SeedAdmin:Senha) ficam fora do repositório: dotnet user-secrets. -->
    <UserSecretsId>almirante-api-2f7c1e0a-5b8d-4c6e-9a31-d4b7e8f2c105</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="13.6.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageReference Include="MediatR" Version="12.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- Fotos de usuários (issue #116): decodificação/reencode com Skia (MIT). O binário nativo do Windows vem com o
         pacote SkiaSharp; o do Linux (imagem Docker) vem do NoDependencies, sem fontconfig. Escolha e mitigações: ADR-0011. -->
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Almirante.ServiceDefaults\Almirante.ServiceDefaults.csproj" />
  </ItemGroup>

  <!-- O binário nativo do Skia para Windows vem com o libSkiaSharp.pdb (~90 MB por arquitetura): símbolos de depuração da
       biblioteca nativa, sem uso no servidor. Fica fora da saída do build e do publish. -->
  <Target Name="SemPdbNativoDoSkia" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(Filename)%(Extension)' == 'libSkiaSharp.pdb'" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(Filename)%(Extension)' == 'libSkiaSharp.pdb'" />
    </ItemGroup>
  </Target>

</Project>
