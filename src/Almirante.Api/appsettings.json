{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Almirante.Api",
    "Audience": "Almirante.Frontend",
    "ActiveKeyId": "",
    "Keys": {},
    "AccessTokenMinutes": 10,
    "AbsoluteSessionDays": 7,
    "RefreshInactivityHours": 24
  },
  "SeedAdmin": {
    "Nome": "Administrador",
    "Email": "admin@local.dev",
    "Senha": ""
  },
  "LoginProtection": {
    "RateLimit": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Lockout": {
      "MaxFailedAttempts": 10,
      "FailureWindowMinutes": 15,
      "LockoutMinutes": 15
    }
  },
  "Hsts": {
    "MaxAgeDays": 365,
    "IncludeSubDomains": false,
    "Preload": false
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200", "http://localhost:4201"]
  },
  "Clube": {
    "FusoHorario": "America/Sao_Paulo"
  },
  "ViaCep": {
    "BaseUrl": "https://viacep.com.br/ws/",
    "TimeoutMs": 5000
  },
  "AuditoriaHttp": {
    "Habilitada": true,
    "DiretorioPendentes": "",
    "LimiteCapturaBytes": 65536,
    "LimiteGravacaoCaracteres": 16384,
    "LimiteDiarioMb": 256,
    "LimiteReservaMemoria": 5000,
    "IntervaloGravacaoMs": 1000,
    "TamanhoLote": 100,
    "EsperaMaximaSegundos": 60
  },
  "Media": {
    "Storage": {
      "Path": "",
      "LimpezaHabilitada": true
    },
    "Images": {
      "MaxUploadSizeMb": 10,
      "MaxStoredSizeMb": 1,
      "MaxWidth": 1024,
      "MaxHeight": 1024,
      "MinWidth": 64,
      "MinHeight": 64,
      "MaxMegapixels": 25,
      "WebpQuality": 82,
      "MinWebpQuality": 60,
      "ProcessingTimeoutMs": 10000,
      "MaxConcurrentProcessing": 2,
      "UploadsPerUserPerWindow": 10,
      "UploadWindowMinutes": 10
    }
  }
}
