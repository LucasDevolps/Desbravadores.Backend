<Project Sdk="Aspire.AppHost.Sdk/13.5.3">

  <ItemGroup>
    <ProjectReference Include="..\Almirante.Api\Almirante.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.6.4" />
    <!-- Transitivos do Aspire.Hosting 13.5.3 com vulnerabilidade conhecida, fixados na versão corrigida (mesmo major):
         MessagePack 2.5.302 (CVE-2026-92707) e System.Security.Cryptography.Pkcs 10.0.11 (CVE-2026-84008/70162).
         Remover quando o Aspire passar a depender das versões corrigidas. -->
    <PackageReference Include="MessagePack" Version="2.5.307" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>70cb5db8-cd1e-4263-b96f-ba58968cf57f</UserSecretsId>
  </PropertyGroup>

</Project>
