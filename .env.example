# Copie este arquivo para ".env" (na raiz do repositório) antes de rodar `docker compose up --build`.
# Nunca versione o arquivo ".env" real com segredos. Todo valor "DEFINA_..." abaixo é um placeholder:
# a API recusa iniciar (chave JWT) ou criar o admin inicial (senha) enquanto ele não for substituído.

# --- SQL Server (container) ---
# Política do SQL Server: >= 8 caracteres com maiúsculas, minúsculas, dígitos e símbolos.
SQL_SA_PASSWORD=DEFINA_UMA_SENHA_FORTE_FORA_DO_GIT
SQL_HOST_PORT=14330
# O SQL Server do container usa certificado autoassinado, por isso a API precisa aceitar
# TrustServerCertificate=True para se conectar localmente (Encrypt continua True). Válido SOMENTE para
# desenvolvimento: se ASPNETCORE_ENVIRONMENT=Production, a API recusa iniciar com este valor True
# (SqlServerConnectionSecurityValidator, issue #36) — configure um certificado confiável no SQL Server
# de produção e deixe esta variável False (ou remova-a) nesse ambiente.
SQL_TRUST_SERVER_CERTIFICATE=True

# --- API ---
# Porta publicada no host. Quem escuta nela é o nginx (reverse proxy), não a API diretamente —
# ver nginx/nginx.conf e compose.yaml.
API_HOST_PORT=8090
# HTTPS local: habilitado por compose.https.yaml; gere o certificado conforme docs/local-login.md.
API_HTTPS_HOST_PORT=8443
ASPNETCORE_ENVIRONMENT=Development

# Rede confiável (CIDR) para os headers X-Forwarded-For/X-Forwarded-Proto enviados pelo nginx.
# Deve corresponder à subnet da rede "almirante-net" definida em compose.yaml. Só se aplica ao
# Docker Compose; fora dele (ex.: IIS) esses headers não são confiados.
API_TRUSTED_PROXY_CIDR=172.30.0.0/24

# --- JWT ---
# Gere com um CSPRNG, uma chave por ambiente: openssl rand -base64 32
# (32 bytes aleatórios DECODIFICADOS; 32 caracteres digitados não servem).
JWT_ISSUER=Almirante.Api
JWT_AUDIENCE=Almirante.Frontend
JWT_ACTIVE_KEY_ID=v1
JWT_KEY_V1=DEFINA_BASE64_DE_32_BYTES_ALEATORIOS
JWT_ACCESS_TOKEN_MINUTES=10
AUTH_SESSION_DAYS=7
AUTH_REFRESH_INACTIVITY_HOURS=24

# --- Proteção do login na própria API (além do nginx) ---
LOGIN_RATE_LIMIT_PERMITS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_LOCKOUT_MAX_FAILURES=10
LOGIN_LOCKOUT_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# --- Usuário administrador inicial (seed idempotente; usado só se o admin ainda não existir) ---
# Política: 12 a 128 caracteres, com letras, sem sequências/repetições, sem conter o e-mail e
# sem raízes triviais (ex.: "senha", "admin", "almirante").
SEED_ADMIN_NOME=Administrador
SEED_ADMIN_EMAIL=admin@local.dev
SEED_ADMIN_SENHA=DEFINA_UMA_SENHA_FORTE_FORA_DO_GIT

# --- CORS (origens do frontend local) ---
CORS_ORIGIN_1=http://localhost:4200
CORS_ORIGIN_2=http://localhost:4201
