# Copie este arquivo para ".env" (na raiz do repositório) antes de rodar `docker compose up --build`.
# Nunca versione o arquivo ".env" real com segredos.

# --- SQL Server (container) ---
SQL_SA_PASSWORD=Almirante_Dev_2026!
SQL_HOST_PORT=14330
# Nomes dos volumes (troque para não reaproveitar volumes de outra stack com o mesmo nome).
SQL_DATA_VOLUME=almirante-sqlserver-data
DATAPROTECTION_VOLUME=almirante-dataprotection

# --- Entrada pública (nginx) ---
# HTTPS é a entrada da API. A porta HTTP só atende /health e /alive e redireciona o resto.
API_HTTPS_HOST_PORT=8443
API_HOST_PORT=8090
# Diretório com tls.crt e tls.key (PEM). Nunca versione. Em desenvolvimento:
#   dotnet dev-certs https --export-path nginx/certs/tls.crt --format PEM --no-password
NGINX_CERTS_DIR=./nginx/certs
ASPNETCORE_ENVIRONMENT=Development

# Rede do Compose. A API só confia em X-Forwarded-For/X-Forwarded-Proto vindos do IP fixo do nginx.
# Se a subnet conflitar com outra rede Docker da máquina, altere as três variáveis juntas.
ALMIRANTE_SUBNET=172.30.0.0/24
NGINX_IPV4=172.30.0.10
API_TRUSTED_PROXY_CIDR=172.30.0.10/32

# --- JWT (gere com: openssl rand -base64 32; nunca versione o valor real) ---
# A API recusa na inicialização chaves ausentes, com menos de 32 bytes, texto legível ou placeholders.
JWT_ISSUER=Almirante.Api
JWT_AUDIENCE=Almirante.Frontend
JWT_ACTIVE_KEY_ID=v1
JWT_KEY_V1=BASE64_DE_32_BYTES_OU_MAIS
JWT_ACCESS_TOKEN_MINUTES=10
AUTH_SESSION_DAYS=7
AUTH_REFRESH_INACTIVITY_HOURS=24

# --- Usuário administrador de desenvolvimento (seed idempotente) ---
SEED_ADMIN_NOME=Administrador
SEED_ADMIN_EMAIL=admin@local.dev
SEED_ADMIN_SENHA=senha

# --- CORS (origens exatas do frontend, sempre HTTPS: o cookie de refresh é SameSite=Strict) ---
CORS_ORIGIN_1=https://localhost:4200
CORS_ORIGIN_2=https://localhost:4201
