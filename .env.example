# Copie este arquivo para ".env" (na raiz do repositório) antes de rodar `docker compose up --build`.
# Nunca versione o arquivo ".env" real com segredos.

# --- SQL Server (container) ---
SQL_SA_PASSWORD=Almirante_Dev_2026!
SQL_HOST_PORT=14330

# --- API ---
API_HOST_PORT=8090
ASPNETCORE_ENVIRONMENT=Development

# --- JWT (gere uma chave própria de pelo menos 32 caracteres para cada ambiente) ---
JWT_ISSUER=Almirante.Api
JWT_AUDIENCE=Almirante.Frontend
JWT_KEY=troque-esta-chave-por-uma-chave-secreta-de-32-ou-mais-caracteres
JWT_EXPIRATION_MINUTES=60

# --- Usuário administrador de desenvolvimento (seed idempotente) ---
SEED_ADMIN_NOME=Administrador
SEED_ADMIN_EMAIL=admin@local.dev
SEED_ADMIN_SENHA=senha

# --- CORS (origens do frontend local) ---
CORS_ORIGIN_1=http://localhost:4200
CORS_ORIGIN_2=http://localhost:4201
