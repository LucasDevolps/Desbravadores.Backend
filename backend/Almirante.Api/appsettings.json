{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Almirante.Api",
    "Audience": "Almirante.Frontend",
    "ActiveKeyId": "",
    "Keys": {},
    "AccessTokenMinutes": 10,
    "AbsoluteSessionDays": 7,
    "RefreshInactivityHours": 24
  },
  "SeedAdmin": {
    "Nome": "Administrador",
    "Email": "admin@local.dev",
    "Senha": ""
  },
  "LoginProtection": {
    "RateLimit": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Lockout": {
      "MaxFailedAttempts": 10,
      "FailureWindowMinutes": 15,
      "LockoutMinutes": 15
    }
  },
  "Hsts": {
    "MaxAgeDays": 365,
    "IncludeSubDomains": false,
    "Preload": false
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200", "http://localhost:4201"]
  }
}
